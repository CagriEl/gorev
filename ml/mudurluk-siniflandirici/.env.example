# Gorev .env ile aynı MySQL bilgilerini kullanabilirsiniz
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gorev
DB_USERNAME=root
DB_PASSWORD=

# SQLite (Gorev geliştirme ortamı)
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/gorev/database/database.sqlite

# Model
MODEL_NAME=dbmdz/bert-base-turkish-cased
MODEL_DIR=./kaydedilen_model
CONFIDENCE_THRESHOLD=0.55

# API
API_HOST=127.0.0.1
API_PORT=8100
API_KEY=

# Eğitim
TRAIN_EPOCHS=3
TRAIN_BATCH_SIZE=8
MAX_LENGTH=128
TEST_SIZE=0.2
RANDOM_SEED=42
